{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "refined-epub-reader",
  "version": "0.1.0",
  "identifier": "com.ta2ro.refined-epub-reader",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "refined-epub-reader",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline' book: http://book.localhost https://book.localhost",
        "img-src": "'self' data: book: http://book.localhost https://book.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost book: http://book.localhost https://book.localhost",
        "font-src": "'self'",
        "frame-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'self' book: http://book.localhost https://book.localhost",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline' book: http://book.localhost https://book.localhost",
        "img-src": "'self' data: book: http://book.localhost https://book.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost book: http://book.localhost https://book.localhost ws://localhost:1420 ws://localhost:1421",
        "font-src": "'self'",
        "frame-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'self' book: http://book.localhost https://book.localhost",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
